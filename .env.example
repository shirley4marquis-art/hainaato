# HainaAuto — environment variables (spec §9).
#
# Copy to .env.local for development. NEVER commit real values — .env* is
# git-ignored. Production values live only in the Vercel project's Environment
# Variables (Production scope) / a secret manager, and MUST be separate from the
# development / preview credentials below.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. Everything else is
# server-only — keep it that way.

# --- Supabase (Auth for the /admin panel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC. Rotate if ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Databases (direct Postgres via pg) ---
CRM_DATABASE_URL=
# Optional: separate DB for the importer / news / security tables. Falls back to
# CRM_DATABASE_URL when unset.
IMPORT_DATABASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
LEADS_FROM_EMAIL=
LEADS_TO_EMAIL=
CUSTOMER_FROM_EMAIL=
SALES_TO_EMAIL=

# --- Server-to-server / cron ---
# Shared secret for the automated quote-PDF render (browser never sees it).
INTERNAL_PDF_SECRET=
# Bearer token required by /api/cron/* — set the same value in Vercel Cron.
CRON_SECRET=

# --- Geo-restriction (spec §1) ---
# CSV of ISO 3166-1 alpha-2 codes to block at the origin (defense in depth;
# Cloudflare's geo firewall rule is the primary enforcement). Default: CN.
# HK / MO / TW are separate codes and are NOT included by a CN block.
BLOCKED_COUNTRIES=CN
# CSV of trusted IPs that bypass the block (exact match, no CIDR).
GEO_IP_ALLOWLIST=
# Optional: Vercel Edge Config connection string. When set, the `geoPolicy` item
# there overrides the two vars above and can be edited with no redeploy.
EDGE_CONFIG=
# Optional: lets /admin/security edit the Edge Config `geoPolicy` item.
VERCEL_API_TOKEN=
EDGE_CONFIG_ID=
VERCEL_TEAM_ID=

# --- Origin lockdown (spec §13) ---
# When set, proxy.ts rejects any request missing `x-edge-auth: <this value>`.
# Cloudflare injects the header via a Transform Rule. Leave BLANK until
# Cloudflare is live in front of the origin, or the site locks itself out.
EDGE_AUTH_SECRET=

# --- Security headers / logging ---
# Set to 1 to ENFORCE the Content-Security-Policy. Unset = Report-Only.
CSP_ENFORCE=
# Salt for hashing IPs in the security_events log. Set a long random value in
# production; rotating it just resets hash continuity (no data loss).
IP_HASH_SALT=

# --- Cloudflare Turnstile (spec §4, §5) ---
# Both must be set for challenges to be enforced (login form + verification).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Legacy (no longer read by the app; safe to delete) ---
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
